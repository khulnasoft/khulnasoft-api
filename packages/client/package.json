{
  "name": "@khulnasoft-api/client",
  "version": "0.0.1",
  "description": "primary client package for khulnasoft-api",
  "author": "dev@khulnasoft.com",
  "license": "ISC",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typedoc": "typedoc --project typedoc.json",
    "test": "VITE_CJS_TRACE=true vitest run",
    "prebuild": "mkdir -p dist/esm && echo '{\"type\": \"module\"}' > dist/esm/package.json",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test",
    "generate-types": "node dist/scripts/run-codegen.js src/test-util generated-api-types.ts ../index"
  },
  "keywords": [
    "khulnasoft",
    "api"
  ],
  "dependencies": {
    "dedent-js": "^1.0.1",
    "lodash": "^4.18.1",
    "prettier": "^2.8.8",
    "khulnasoft": "workspace:*",
    "typescript": "^5.3.2",
    "zod": "^3.22.4",
    "zod-to-ts": "^1.2.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.28.0",
    "@types/lodash": "^4.14.202",
    "@types/prettier": "^2.7.3",
    "ts-node": "^10.9.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.0",
    "typedoc": "0.28.20"
  },
  "peerDependencies": {
    "@tanstack/react-query": "~5.x"
  }
}
